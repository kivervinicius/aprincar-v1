{
  "name": "aprincar-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aprincar/app",
    "dev:hub": "npm run dev -w @aprincar/hub",
    "build": "npm run build -w @aprincar/app && npm run build -w @aprincar/hub",
    "typecheck": "tsc -p tsconfig.all.json",
    "test": "node --experimental-strip-types --test packages/core-tests/*.test.ts",
    "test:unit": "npm run test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "prepare": "husky",
    "verify:official": "node scripts/verify-official-snapshot.mjs",
    "check:production": "npm run check && npm run verify:official && npm run test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "@eslint/js": "^9.35.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
